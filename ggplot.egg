((synopsis "A declarative plotting system based on Grammar of Graphics.")
 (license "GPL-3")
 (category graphics)
 (author "Ivan Raikov")
 (dependencies srfi-1 datatype matchable yasos statistics pdf)
 (test-dependencies test)
 (components
              (extension gg-backend
                         (csc-options "-O3" "-d1"))
              (extension gg-backend-pdf
                         (csc-options "-O3" "-d1")
                         (component-dependencies gg-backend))
              (cond-expand
               [cairo (extension gg-backend-cairo
                                  (csc-options "-O3" "-d1")
                                  (component-dependencies gg-backend))]
               (else))
              (cond-expand
               [libplot (extension gg-backend-libplot
                                   (csc-options "-O3" "-d1")
                                   (component-dependencies gg-backend))]
               (else))
              (extension gg-vge
                         (csc-options "-O3" "-d1")
                         (component-dependencies
                          gg-backend))
              (extension gg-primitives-vge
                         (csc-options "-O3" "-d1")
                         (component-dependencies
                          gg-backend gg-vge))
              (extension gg-scales
                         (csc-options "-O3" "-d1"))
              (extension gg-guides
                         (csc-options "-O3" "-d1")
                         (component-dependencies gg-scales gg-primitives-vge))
              (extension gg-aes
                         (csc-options "-O3" "-d1"))
              (extension gg-data
                         (csc-options "-O3" "-d1"))
              (extension gg-geom
                         (csc-options "-O3" "-d1")
                         (component-dependencies
                          gg-primitives-vge gg-scales gg-data gg-aes))
              (extension gg-layout
                         (csc-options "-O3" "-d1")
                         (component-dependencies gg-backend gg-primitives-vge gg-scales))
              ;; gg-plot imports gg-backend-cairo only when the library is
              ;; built with the cairo feature; the -D cairo compile flag
              ;; selects that cond-expand branch inside gg-plot.scm.
              (cond-expand
               [cairo (extension gg-plot
                                 (csc-options "-O3" "-d1" "-D" "cairo")
                                 (component-dependencies
                                  gg-primitives-vge
                                  gg-scales
                                  gg-data
                                  gg-aes
                                  gg-geom
                                  gg-guides
                                  gg-layout
                                  gg-backend
                                  gg-backend-pdf
                                  gg-backend-cairo))]
               [else (extension gg-plot
                                (csc-options "-O3" "-d1")
                                (component-dependencies
                                 gg-primitives-vge
                                 gg-scales
                                 gg-data
                                 gg-aes
                                 gg-geom
                                 gg-guides
                                 gg-layout
                                 gg-backend
                                 gg-backend-pdf))])
              )
 )